generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ORG_ADMIN
  EDITOR
  VIEWER
}

enum DataSourceType {
  POSTGRESQL
  MYSQL
  CSV
  API
}

enum DataSourceStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum ExecutionTrigger {
  MANUAL
  SCHEDULED
  RETRY
}

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  plan                String   @default("STARTER") // STARTER, BUSINESS, ENTERPRISE
  maxUsers            Int?     @map("max_users")
  fileRetentionDays   Int      @map("file_retention_days") @default(90)
  createdAt           DateTime @default(now()) @map("created_at")
  users               User[]
  dataSources         DataSource[]
  queries             Query[]
  reports             ReportTemplate[]
  schedules           Schedule[]
  notifications       Notification[]
  notificationChannels NotificationChannel[]
  generatedFiles      GeneratedFile[]
  auditLogs           AuditLog[]

  @@map("organizations")
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  orgId         String       @map("org_id") @db.Uuid
  email         String       @unique
  passwordHash  String?      @map("password_hash") // null if OAuth only
  role          Role         @default(VIEWER)
  createdAt     DateTime     @default(now()) @map("created_at")
  org           Organization @relation(fields: [orgId], references: [id])
  accounts      Account[]
  sessions      Session[]
  // future: profile fields, avatar, etc.

  @@map("users")
}

// NextAuth required models
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   // e.g. "DATASOURCE_CREATED", "REPORT_EXPORTED"
  entityType String   @map("entity_type") // "datasource", "report", etc.
  entityId   String?  @map("entity_id")
  details    Json?    // extra payload
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  org        Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
// ─── Data Sources ──────────────────────────────────────────────
model DataSource {
  id                String            @id @default(uuid()) @db.Uuid
  orgId             String            @map("org_id") @db.Uuid
  name              String
  type              DataSourceType    @default(POSTGRESQL)
  connectionDetails Json              @map("connection_details") // {host, port, database, username, baseUrl, headers, etc}
  passwordEnc       String?           @map("password_enc") // encrypted password stored separately
  status            DataSourceStatus  @default(ACTIVE)
  lastTested        DateTime?         @map("last_tested")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  org               Organization      @relation(fields: [orgId], references: [id])
  queries           Query[]

  @@map("data_sources")
}

// ─── Queries ───────────────────────────────────────────────────
model Query {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  dataSourceId  String      @map("data_source_id") @db.Uuid
  name          String
  description   String?
  sqlText       String      @map("sql_text") @db.Text
  parameters    Json?       // {paramName: "type", ...}
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id])
  dataSource    DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  versions      QueryVersion[]

  @@map("queries")
}

model QueryVersion {
  id        String   @id @default(uuid()) @db.Uuid
  queryId   String   @map("query_id") @db.Uuid
  sqlText   String   @map("sql_text") @db.Text
  parameters Json?
  createdAt DateTime @default(now()) @map("created_at")
  query     Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@map("query_versions")
}

// ─── Report Templates ──────────────────────────────────────────
model ReportTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  queryId       String?  @map("query_id") @db.Uuid
  title         String
  description   String?
  format        String   @default("PDF") // PDF, EXCEL, CSV
  columnsConfig Json?    @map("columns_config") // {columnName: {visible, order, format, ...}, ...}
  templateFile  String?  @map("template_file")
  lastRunAt     DateTime? @map("last_run_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id])

  @@map("report_templates")
}

// ─── Schedules ─────────────────────────────────────────────────
model Schedule {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  reportId    String?  @map("report_id") @db.Uuid
  name        String
  cronExpr    String   @map("cron_expr") @default("0 9 * * 1")
  recipients  String[] @default([])
  retryCount  Int      @map("retry_count") @default(3)
  enabled     Boolean  @default(true)
  lastRunAt   DateTime? @map("last_run_at")
  nextRunAt   DateTime? @map("next_run_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  org         Organization @relation(fields: [orgId], references: [id])
  executions  ExecutionLog[]

  @@map("schedules")
}

model ExecutionLog {
  id          String            @id @default(uuid()) @db.Uuid
  scheduleId  String            @map("schedule_id") @db.Uuid
  status      ExecutionStatus   @default(PENDING)
  trigger     ExecutionTrigger  @default(MANUAL)
  duration    Int?              // milliseconds
  output      String?           @db.Text // result file path or error details
  error       String?           @db.Text
  createdAt   DateTime          @default(now()) @map("created_at")
  schedule    Schedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("execution_logs")
}

// ─── Notifications ─────────────────────────────────────────────
model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  type        String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS
  title       String
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  org         Organization @relation(fields: [orgId], references: [id])

  @@map("notifications")
}

model NotificationChannel {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  type      String   // "EMAIL", "TELEGRAM"
  name      String
  config    Json     // {smtp settings or telegram token}
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id])

  @@map("notification_channels")
}

model GeneratedFile {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  scheduleId  String?  @map("schedule_id") @db.Uuid
  reportId    String?  @map("report_id") @db.Uuid
  fileName    String   @map("file_name")
  fileSize    Int      @map("file_size")
  filePath    String   @map("file_path")
  fileType    String   @map("file_type") // pdf, xlsx, csv
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")
  org         Organization @relation(fields: [orgId], references: [id])

  @@map("generated_files")
}
